# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_CAMPAIGN_TREASURY=

# The Graph (gateway key from Subgraph Studio)
THEGRAPH_API_KEY=
# THEGRAPH_GATEWAY_URL=https://gateway.thegraph.com/api

# Hedera x402 (agent pays; payTo receives)
HEDERA_PAY_TO_ACCOUNT=
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# X402_PRICE_TINYBARS=100000

# Hedera HTS operator (falls back to HEDERA_AGENT_* if unset)
# HEDERA_OPERATOR_ACCOUNT_ID=
# HEDERA_OPERATOR_PRIVATE_KEY=
# Account that receives an airdropped share, then can be frozen
# HEDERA_BACKER_ACCOUNT_ID=

# Optional: rewrite the risk note with an LLM
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: persist pledges / token lifecycle / approvals (default .data/state.json)
# ZIKIBOLS_DATA_PATH=
